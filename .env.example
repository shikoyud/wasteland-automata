# World server. Copy to .env only if you want to change a default; `pnpm dev` works without it.
WA_ENV=local                 # local | test | production
PORT=8787
HOST=0.0.0.0
WORLD_ID=w1
WORLD_SEED=w1-local          # the season seed decides the map; required in production
DEV_AGENTS=3                 # agents with fixed tokens wa_dev_1..N; must be 0 in production

# Local stack from docker-compose.yml (not used by the server until sprint 2)
DATABASE_URL=postgres://wa:wa@localhost:5432/wa
CHAIN_RPC_URL=http://localhost:8545
PG_PORT=5432
ANVIL_PORT=8545
