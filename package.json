{
  "name": "wasteland-automata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "node scripts/test.mjs unit",
    "test:acceptance": "node scripts/test.mjs acceptance",
    "guide": "pnpm --filter @wa/rules run guide",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
