{
  "name": "@wa/rules",
  "version": "0.1.0",
  "private": true,
  "description": "rules.json, its types and the agent guide generator.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./rules.json": "./rules.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\"",
    "guide": "node src/cli.ts --out dist/guide.md --max-tokens 4000"
  },
  "devDependencies": {
    "gpt-tokenizer": "^3.0.1"
  }
}
